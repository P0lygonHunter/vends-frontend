# Do not commit your real .env file.
MONGO_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-random-32-plus-character-secret
CEO_EMAIL=your-ceo-email@example.com
# Generate with: node scripts/hash-password.js "your-CEO-password"
CEO_PASSWORD_HASH=scrypt$replace-with-a-password-hash
NODE_ENV=production

# Support shown on blocked-account errors
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=+92-300-0000000

# Email OTP (Gmail app password / Resend / any SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Vends EduCore <your@gmail.com>"

# Local/testing only — returns OTP in API JSON when SMTP missing
ALLOW_DEV_OTP=true

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
